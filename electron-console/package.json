{
  "name": "aurora-console",
  "version": "1.0.3",
  "description": "AURORA Endpoint Control Management Console",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aurora.control.console",
    "productName": "AURORA Endpoint Control Console",
    "directories": {
      "output": "../dist-installers"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "."
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
