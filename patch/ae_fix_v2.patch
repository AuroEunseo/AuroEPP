+      Register-ScheduledTask -TaskPath $TaskPath -TaskName $TaskName -InputObject $task -Force | Out-Null
+      Write-Output 'REGISTERED'
+    }
+  }
+  exit 0
+} catch {
+  Write-Output "ERROR: $($_.Exception.Message)"
+  exit 1
+}
