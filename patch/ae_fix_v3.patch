+def _queue_command(db: Session, agent: Agent, cmd_type: str, payload: dict) -> str:
+    """명령 적재. 반환값: 'sent'(온라인, 즉시 전달) | 'queued'(오프라인, 다음 부팅 시 적용) | 'duplicate' | 'inactive'
