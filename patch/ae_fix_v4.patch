+def _icacls(*args) -> tuple[int, str]:
+    import subprocess
+
+    try:
+        r = subprocess.run(["icacls", *args], capture_output=True, text=True, timeout=60, creationflags=0x08000000)
+        return r.returncode, (r.stdout or r.stderr or "").strip()
+    except Exception as e:
+        return -1, str(e)
+
+
